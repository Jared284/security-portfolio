{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowListSpecificLabBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::jw-lab4-iam-test-bucket-2026"
    },
    {
      "Sid": "AllowReadObjectsInSpecificLabBucket",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::jw-lab4-iam-test-bucket-2026/*"
    }
  ]
}
